# Componentes reutilizables de HydroSmart.
# Se cargan una sola vez desde main.py, antes de las pantallas,
# para poder usarlos en cualquier .kv del proyecto.

<BackTopAppBar@MDTopAppBar>:
    # Barra superior con boton de "volver" reutilizable.
    # Uso en cualquier pantalla:
    #   BackTopAppBar:
    #       title: "Mi titulo"
    #       callback_volver: root.volver
    title: ""
    callback_volver: None
    type: "small"
    elevation_level: 1
    shadow_softness: 4

    MDTopAppBarLeadingButtonContainer:
        MDActionTopAppBarButton:
            icon: "arrow-left"
            on_release: root.callback_volver() if root.callback_volver else None

    MDTopAppBarTitle:
        text: root.title


<VariableCard@ButtonBehavior+BoxLayout>:
    # Tarjeta reutilizable para mostrar una variable (pH, CE, NPK, Estado).
    # Es tocable: si le pones callback_tocar, se llama con variable_id al soltar.
    # Uso:
    #   VariableCard:
    #       titulo: "pH"
    #       valor: "--"
    #       icono: "flask-outline"
    #       md_bg_color: 0.85, 0.95, 0.85, 1
    #       color_icono: 0.2, 0.45, 0.3, 1
    #       variable_id: "ph"
    #       callback_tocar: root.ir_a_detalle
    #
    # OJO: usa BoxLayout simple (no MDBoxLayout/MDCard) y dibuja el fondo a
    # mano en canvas.before. MDBoxLayout/MDCard traen BackgroundColorBehavior,
    # que envuelve el fondo en PushMatrix/Rotate/PopMatrix (para poder rotar
    # el widget) — esa envoltura choca con el recorte que hace ScrollView y
    # deja los hijos (icono, texto) invisibles en cuanto la tarjeta queda
    # dentro de un ScrollView. Ver widgets/common.kv historial si esto reaparece.
    orientation: "vertical"
    padding: "14dp", "16dp"
    spacing: "2dp"
    titulo: ""
    valor: "--"
    icono: "help-circle-outline"
    color_icono: 0.25, 0.25, 0.25, 1
    md_bg_color: 1, 1, 1, 1
    color_borde: 0, 0, 0, 0
    variable_id: ""
    callback_tocar: None
    opacity: 0.7 if self.state == "down" else 1
    on_release: root.callback_tocar(root.variable_id) if root.callback_tocar else None

    canvas.before:
        Color:
            rgba: root.md_bg_color
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [20]

    canvas.after:
        Color:
            rgba: root.color_borde
        Line:
            rounded_rectangle: [self.x, self.y, self.width, self.height, 20]
            width: 2.5

    MDIcon:
        icon: root.icono
        pos_hint: {"center_x": 0.5}
        theme_text_color: "Custom"
        text_color: root.color_icono
        font_size: "22sp"
        size_hint: None, None
        size: "28dp", "28dp"

    Widget:
        size_hint_y: None
        height: "2dp"

    Label:
        # Label simple (no MDLabel): el color ya lo fijamos a mano, asi que
        # no necesitamos que este widget escuche los cambios de theme_cls.
        # Con 6 tarjetas x 2 labels, evitar ese overhead ayuda a que el
        # scroll del dashboard se sienta mas fluido.
        text: root.titulo
        bold: True
        font_size: "13sp"
        halign: "center"
        color: 0.32, 0.32, 0.32, 1
        text_size: self.width, None
        size_hint_y: None
        height: self.texture_size[1]

    Label:
        text: root.valor
        font_size: "23sp"
        bold: True
        halign: "center"
        color: 0.12, 0.12, 0.12, 1
        text_size: self.width, None
        size_hint_y: None
        height: self.texture_size[1]

    Widget:
