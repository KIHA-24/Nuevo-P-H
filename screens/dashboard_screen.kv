<DashboardScreen>:
    name: "dashboard"
    md_bg_color: self.theme_cls.backgroundColor

    MDBoxLayout:
        orientation: "vertical"

        MDTopAppBar:
            type: "small"
            elevation_level: 1
            shadow_softness: 4

            MDTopAppBarLeadingButtonContainer:
                MDActionTopAppBarButton:
                    icon: "sprout"

            MDTopAppBarTitle:
                id: titulo_appbar
                text: "Dashboard - HydroSmart"

            MDTopAppBarTrailingButtonContainer:
                MDActionTopAppBarButton:
                    icon: "logout"
                    on_release: root.cerrar_sesion()

        MDBoxLayout:
            orientation: "horizontal"
            size_hint_y: None
            height: "52dp"
            padding: "12dp", "6dp"
            spacing: "8dp"

            ScrollView:
                do_scroll_y: False

                MDBoxLayout:
                    id: fila_cultivos
                    orientation: "horizontal"
                    spacing: "8dp"
                    padding: "2dp"
                    size_hint_x: None
                    width: self.minimum_width

            MDIconButton:
                icon: "plus"
                style: "tonal"
                on_release: root.abrir_dialogo_nuevo_cultivo()

        MDDivider:

        MDBoxLayout:
            orientation: "vertical"
            padding: "16dp"
            spacing: "14dp"

            ScrollView:
                do_scroll_x: False
                effect_cls: "ScrollEffect"

                MDBoxLayout:
                    orientation: "vertical"
                    spacing: "10dp"
                    size_hint_y: None
                    height: self.minimum_height

                    TarjetaVariableBarra:
                        id: card_ph
                        nombre: "pH"
                        unidad: ""
                        icono: "flask-outline"
                        md_bg_color: 0.80, 0.92, 0.91, 1
                        color_icono: 0.0, 0.35, 0.35, 1
                        variable_id: "ph"
                        callback_tocar: root.ir_a_detalle

                    TarjetaVariableBarra:
                        id: card_ce
                        nombre: "CE"
                        unidad: "mS/cm"
                        icono: "flash-outline"
                        md_bg_color: 0.82, 0.90, 0.95, 1
                        color_icono: 0.05, 0.35, 0.5, 1
                        variable_id: "ce"
                        callback_tocar: root.ir_a_detalle

                    TarjetaVariableBarra:
                        id: card_n
                        nombre: "N"
                        unidad: "ppm"
                        icono: "alpha-n-circle-outline"
                        md_bg_color: 0.85, 0.93, 0.82, 1
                        color_icono: 0.15, 0.45, 0.15, 1
                        variable_id: "n"
                        callback_tocar: root.ir_a_detalle

                    TarjetaVariableBarra:
                        id: card_p
                        nombre: "P"
                        unidad: "ppm"
                        icono: "alpha-p-circle-outline"
                        md_bg_color: 0.92, 0.85, 0.95, 1
                        color_icono: 0.45, 0.15, 0.55, 1
                        variable_id: "p"
                        callback_tocar: root.ir_a_detalle

                    TarjetaVariableBarra:
                        id: card_k
                        nombre: "K"
                        unidad: "ppm"
                        icono: "alpha-k-circle-outline"
                        md_bg_color: 0.97, 0.90, 0.78, 1
                        color_icono: 0.60, 0.40, 0.05, 1
                        variable_id: "k"
                        callback_tocar: root.ir_a_detalle

                    TarjetaVariableBarra:
                        id: card_temperatura
                        nombre: "Temp."
                        unidad: "°C"
                        icono: "thermometer"
                        md_bg_color: 0.99, 0.85, 0.80, 1
                        color_icono: 0.75, 0.28, 0.05, 1
                        variable_id: "temperatura"
                        callback_tocar: root.ir_a_detalle

                    TarjetaVariableBarra:
                        id: card_humedad
                        nombre: "Hum."
                        unidad: "%"
                        icono: "water-percent"
                        md_bg_color: 0.80, 0.88, 0.97, 1
                        color_icono: 0.05, 0.3, 0.6, 1
                        variable_id: "humedad"
                        callback_tocar: root.ir_a_detalle

                    TarjetaVariableBarra:
                        id: card_iluminacion
                        nombre: "Luz"
                        unidad: "lux"
                        icono: "white-balance-sunny"
                        md_bg_color: 0.99, 0.94, 0.75, 1
                        color_icono: 0.65, 0.5, 0.0, 1
                        variable_id: "iluminacion"
                        callback_tocar: root.ir_a_detalle

            MDDivider:

            MDBoxLayout:
                spacing: "10dp"
                size_hint_y: None
                height: "48dp"

                BotonAncho:
                    style: "tonal"
                    theme_width: "Custom"
                    size_hint_x: 1
                    on_release: root.ir_a("detalle")
                    MDButtonIcon:
                        icon: "chart-line"
                    MDButtonText:
                        text: "Detalle"

                BotonAncho:
                    style: "tonal"
                    theme_width: "Custom"
                    size_hint_x: 1
                    on_release: root.ir_a("historial")
                    MDButtonIcon:
                        icon: "history"
                    MDButtonText:
                        text: "Historial"

                BotonAncho:
                    style: "tonal"
                    theme_width: "Custom"
                    size_hint_x: 1
                    on_release: root.ir_a("configuracion")
                    MDButtonIcon:
                        icon: "cog-outline"
                    MDButtonText:
                        text: "Config"
