<DetalleScreen>:
    name: "detalle"
    md_bg_color: self.theme_cls.backgroundColor

    MDBoxLayout:
        orientation: "vertical"

        BackTopAppBar:
            id: barra_superior
            title: "Detalle de variable"
            callback_volver: root.volver

        ScrollView:
            do_scroll_x: False

            MDBoxLayout:
                orientation: "vertical"
                padding: "20dp"
                spacing: "16dp"
                size_hint_y: None
                height: self.minimum_height

                MDGridLayout:
                    cols: 3
                    spacing: "8dp"
                    size_hint_y: None
                    height: "148dp"

                    BotonAncho:
                        style: "filled" if root.variable_actual == "ph" else "outlined"
                        theme_width: "Custom"
                        size_hint_x: 1
                        on_release: root.mostrar_variable("ph")
                        MDButtonText:
                            text: "pH"

                    BotonAncho:
                        style: "filled" if root.variable_actual == "ce" else "outlined"
                        theme_width: "Custom"
                        size_hint_x: 1
                        on_release: root.mostrar_variable("ce")
                        MDButtonText:
                            text: "CE"

                    BotonAncho:
                        style: "filled" if root.variable_actual == "n" else "outlined"
                        theme_width: "Custom"
                        size_hint_x: 1
                        on_release: root.mostrar_variable("n")
                        MDButtonText:
                            text: "N"

                    BotonAncho:
                        style: "filled" if root.variable_actual == "p" else "outlined"
                        theme_width: "Custom"
                        size_hint_x: 1
                        on_release: root.mostrar_variable("p")
                        MDButtonText:
                            text: "P"

                    BotonAncho:
                        style: "filled" if root.variable_actual == "k" else "outlined"
                        theme_width: "Custom"
                        size_hint_x: 1
                        on_release: root.mostrar_variable("k")
                        MDButtonText:
                            text: "K"

                    BotonAncho:
                        style: "filled" if root.variable_actual == "temperatura" else "outlined"
                        theme_width: "Custom"
                        size_hint_x: 1
                        on_release: root.mostrar_variable("temperatura")
                        MDButtonText:
                            text: "Temp."

                    BotonAncho:
                        style: "filled" if root.variable_actual == "humedad" else "outlined"
                        theme_width: "Custom"
                        size_hint_x: 1
                        on_release: root.mostrar_variable("humedad")
                        MDButtonText:
                            text: "Humedad"

                    BotonAncho:
                        style: "filled" if root.variable_actual == "iluminacion" else "outlined"
                        theme_width: "Custom"
                        size_hint_x: 1
                        on_release: root.mostrar_variable("iluminacion")
                        MDButtonText:
                            text: "Luz"

                MDCard:
                    orientation: "vertical"
                    # IMPORTANTE: theme_elevation_level debe quedar en
                    # "Custom" (no el default "Primary"). MDCard.
                    # set_properties_widget() pone elevation_level=1 solo
                    # con TOCAR o soltar la tarjeta -incluso con
                    # style="outlined"/"filled"- mientras
                    # theme_elevation_level siga en "Primary". Esa sombra
                    # real se renderiza con un blur recursivo via Fbo que
                    # crashea esta GPU Adreno con SIGSEGV en
                    # libGLESv2_adreno.so (confirmado en dispositivo:
                    # reproducido con un solo toque sobre la tarjeta/la
                    # grafica de abajo). Mismo patron de bug ya documentado
                    # para ripple_effect/transiciones Fbo en este proyecto,
                    # pero un codepath distinto que esos fixes no cubren.
                    style: "outlined"
                    theme_elevation_level: "Custom"
                    elevation_level: 0
                    radius: [20]
                    padding: "18dp"
                    spacing: "4dp"
                    size_hint_y: None
                    height: "130dp"

                    MDIcon:
                        id: icono_variable
                        icon: "flask-outline"
                        pos_hint: {"center_x": 0.5}
                        theme_text_color: "Custom"
                        text_color: 0.0, 0.35, 0.35, 1
                        font_size: "22sp"

                    MDLabel:
                        id: titulo_variable
                        text: "pH"
                        bold: True
                        halign: "center"
                        theme_text_color: "Secondary"
                        font_size: "13sp"
                        size_hint_y: None
                        height: self.texture_size[1]

                    MDLabel:
                        id: valor_actual
                        text: "--"
                        font_size: "34sp"
                        bold: True
                        halign: "center"
                        size_hint_y: None
                        height: self.texture_size[1]

                MDCard:
                    orientation: "vertical"
                    # Ver el comentario de la tarjeta de valor arriba: sin
                    # esto, tocar la grafica (que no consume el touch)
                    # llega a esta tarjeta y dispara el mismo crash.
                    style: "outlined"
                    theme_elevation_level: "Custom"
                    elevation_level: 0
                    radius: [20]
                    padding: "20dp"
                    spacing: "8dp"
                    size_hint_y: None
                    height: self.minimum_height

                    MDLabel:
                        text: "Grafica de tendencia"
                        bold: True
                        halign: "center"
                        theme_text_color: "Secondary"
                        size_hint_y: None
                        height: self.texture_size[1]

                    GraficaTendencia:
                        id: grafica_tendencia
                        size_hint_y: None
                        height: "190dp"

                    MDLabel:
                        id: mensaje_historial
                        text: "Aun no hay datos historicos para graficar"
                        halign: "center"
                        theme_text_color: "Secondary"
                        font_size: "12sp"
                        size_hint_y: None
                        height: self.texture_size[1]
