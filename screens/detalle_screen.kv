<DetalleScreen>:
    name: "detalle"
    md_bg_color: self.theme_cls.backgroundColor

    MDBoxLayout:
        orientation: "vertical"

        BackTopAppBar:
            id: barra_superior
            title: "Detalle de variable"
            callback_volver: root.volver

        ScrollView:
            do_scroll_x: False

            MDBoxLayout:
                orientation: "vertical"
                padding: "20dp"
                spacing: "16dp"
                size_hint_y: None
                height: self.minimum_height

                MDGridLayout:
                    cols: 3
                    spacing: "8dp"
                    size_hint_y: None
                    height: "148dp"

                    BotonAncho:
                        style: "filled" if root.variable_actual == "ph" else "outlined"
                        theme_width: "Custom"
                        size_hint_x: 1
                        on_release: root.mostrar_variable("ph")
                        MDButtonText:
                            text: "pH"

                    BotonAncho:
                        style: "filled" if root.variable_actual == "ce" else "outlined"
                        theme_width: "Custom"
                        size_hint_x: 1
                        on_release: root.mostrar_variable("ce")
                        MDButtonText:
                            text: "CE"

                    BotonAncho:
                        style: "filled" if root.variable_actual == "n" else "outlined"
                        theme_width: "Custom"
                        size_hint_x: 1
                        on_release: root.mostrar_variable("n")
                        MDButtonText:
                            text: "N"

                    BotonAncho:
                        style: "filled" if root.variable_actual == "p" else "outlined"
                        theme_width: "Custom"
                        size_hint_x: 1
                        on_release: root.mostrar_variable("p")
                        MDButtonText:
                            text: "P"

                    BotonAncho:
                        style: "filled" if root.variable_actual == "k" else "outlined"
                        theme_width: "Custom"
                        size_hint_x: 1
                        on_release: root.mostrar_variable("k")
                        MDButtonText:
                            text: "K"

                    BotonAncho:
                        style: "filled" if root.variable_actual == "temperatura" else "outlined"
                        theme_width: "Custom"
                        size_hint_x: 1
                        on_release: root.mostrar_variable("temperatura")
                        MDButtonText:
                            text: "Temp."

                    BotonAncho:
                        style: "filled" if root.variable_actual == "humedad" else "outlined"
                        theme_width: "Custom"
                        size_hint_x: 1
                        on_release: root.mostrar_variable("humedad")
                        MDButtonText:
                            text: "Humedad"

                    BotonAncho:
                        style: "filled" if root.variable_actual == "iluminacion" else "outlined"
                        theme_width: "Custom"
                        size_hint_x: 1
                        on_release: root.mostrar_variable("iluminacion")
                        MDButtonText:
                            text: "Luz"

                MDCard:
                    orientation: "vertical"
                    # "outlined" (sin sombra), no "elevated": la sombra real
                    # de KivyMD renderiza un blur recursivo via Fbo que
                    # crashea esta GPU Adreno con SIGSEGV en
                    # libGLESv2_adreno.so (confirmado en dispositivo, mismo
                    # patron de bug ya documentado para ripple_effect/
                    # transiciones Fbo en este proyecto, pero un codepath
                    # distinto que ese fix no cubre).
                    style: "outlined"
                    radius: [20]
                    padding: "18dp"
                    spacing: "4dp"
                    size_hint_y: None
                    height: "130dp"

                    MDIcon:
                        id: icono_variable
                        icon: "flask-outline"
                        pos_hint: {"center_x": 0.5}
                        theme_text_color: "Custom"
                        text_color: 0.0, 0.35, 0.35, 1
                        font_size: "22sp"

                    MDLabel:
                        id: titulo_variable
                        text: "pH"
                        bold: True
                        halign: "center"
                        theme_text_color: "Secondary"
                        font_size: "13sp"
                        size_hint_y: None
                        height: self.texture_size[1]

                    MDLabel:
                        id: valor_actual
                        text: "--"
                        font_size: "34sp"
                        bold: True
                        halign: "center"
                        size_hint_y: None
                        height: self.texture_size[1]

                MDCard:
                    orientation: "vertical"
                    style: "outlined"
                    radius: [20]
                    padding: "20dp"
                    spacing: "8dp"
                    size_hint_y: None
                    height: self.minimum_height

                    MDLabel:
                        text: "Grafica de tendencia"
                        bold: True
                        halign: "center"
                        theme_text_color: "Secondary"
                        size_hint_y: None
                        height: self.texture_size[1]

                    GraficaTendencia:
                        id: grafica_tendencia
                        size_hint_y: None
                        height: "190dp"

                    MDLabel:
                        id: mensaje_historial
                        text: "Aun no hay datos historicos para graficar"
                        halign: "center"
                        theme_text_color: "Secondary"
                        font_size: "12sp"
                        size_hint_y: None
                        height: self.texture_size[1]
