<DetalleScreen>:
    name: "detalle"
    md_bg_color: self.theme_cls.backgroundColor

    MDBoxLayout:
        orientation: "vertical"

        BackTopAppBar:
            id: barra_superior
            title: "Detalle de variable"
            callback_volver: root.volver

        ScrollView:
            do_scroll_x: False

            MDBoxLayout:
                orientation: "vertical"
                padding: "20dp"
                spacing: "16dp"
                size_hint_y: None
                height: self.minimum_height

                MDGridLayout:
                    cols: 3
                    spacing: "8dp"
                    size_hint_y: None
                    height: "148dp"

                    BotonAncho:
                        style: "filled" if root.variable_actual == "ph" else "outlined"
                        theme_width: "Custom"
                        size_hint_x: 1
                        on_release: root.mostrar_variable("ph")
                        MDButtonText:
                            text: "pH"

                    BotonAncho:
                        style: "filled" if root.variable_actual == "ce" else "outlined"
                        theme_width: "Custom"
                        size_hint_x: 1
                        on_release: root.mostrar_variable("ce")
                        MDButtonText:
                            text: "CE"

                    BotonAncho:
                        style: "filled" if root.variable_actual == "n" else "outlined"
                        theme_width: "Custom"
                        size_hint_x: 1
                        on_release: root.mostrar_variable("n")
                        MDButtonText:
                            text: "N"

                    BotonAncho:
                        style: "filled" if root.variable_actual == "p" else "outlined"
                        theme_width: "Custom"
                        size_hint_x: 1
                        on_release: root.mostrar_variable("p")
                        MDButtonText:
                            text: "P"

                    BotonAncho:
                        style: "filled" if root.variable_actual == "k" else "outlined"
                        theme_width: "Custom"
                        size_hint_x: 1
                        on_release: root.mostrar_variable("k")
                        MDButtonText:
                            text: "K"

                    BotonAncho:
                        style: "filled" if root.variable_actual == "temperatura" else "outlined"
                        theme_width: "Custom"
                        size_hint_x: 1
                        on_release: root.mostrar_variable("temperatura")
                        MDButtonText:
                            text: "Temp."

                    BotonAncho:
                        style: "filled" if root.variable_actual == "humedad" else "outlined"
                        theme_width: "Custom"
                        size_hint_x: 1
                        on_release: root.mostrar_variable("humedad")
                        MDButtonText:
                            text: "Humedad"

                    BotonAncho:
                        style: "filled" if root.variable_actual == "iluminacion" else "outlined"
                        theme_width: "Custom"
                        size_hint_x: 1
                        on_release: root.mostrar_variable("iluminacion")
                        MDButtonText:
                            text: "Luz"

                BoxLayout:
                    # NO MDCard: CommonElevationBehavior (la base de TODA
                    # MDCard, sin importar "style" ni elevation_level)
                    # agrega siempre un BoxShadow nativo de Kivy en su
                    # canvas.before envuelto en PushMatrix/Scale/Rotate/
                    # PopMatrix - incluso con elevation_level=0 el
                    # BoxShadow se sigue creando y dibujando, solo con
                    # blur_radius=0. Ese patron crashea esta GPU Adreno con
                    # SIGSEGV en libGLESv2_adreno.so apenas se toca la
                    # tarjeta (confirmado en dispositivo). Por eso
                    # VariableCard/TarjetaVariableBarra en este proyecto ya
                    # evitan MDCard y dibujan el fondo a mano - mismo
                    # criterio aca.
                    orientation: "vertical"
                    padding: "18dp"
                    spacing: "4dp"
                    size_hint_y: None
                    height: "130dp"

                    canvas.before:
                        Color:
                            rgba: app.theme_cls.backgroundColor
                        RoundedRectangle:
                            pos: self.pos
                            size: self.size
                            radius: [20]

                    canvas.after:
                        Color:
                            rgba: 0.6, 0.6, 0.6, 0.5
                        Line:
                            rounded_rectangle: [self.x, self.y, self.width, self.height, 20]
                            width: 1.2

                    MDIcon:
                        id: icono_variable
                        icon: "flask-outline"
                        pos_hint: {"center_x": 0.5}
                        theme_text_color: "Custom"
                        text_color: 0.0, 0.35, 0.35, 1
                        font_size: "22sp"

                    MDLabel:
                        id: titulo_variable
                        text: "pH"
                        bold: True
                        halign: "center"
                        theme_text_color: "Secondary"
                        font_size: "13sp"
                        size_hint_y: None
                        height: self.texture_size[1]

                    MDLabel:
                        id: valor_actual
                        text: "--"
                        font_size: "34sp"
                        bold: True
                        halign: "center"
                        size_hint_y: None
                        height: self.texture_size[1]

                BoxLayout:
                    # Ver el comentario de la tarjeta de valor arriba: por
                    # que no es MDCard.
                    orientation: "vertical"
                    padding: "20dp"
                    spacing: "8dp"
                    size_hint_y: None
                    height: self.minimum_height

                    canvas.before:
                        Color:
                            rgba: app.theme_cls.backgroundColor
                        RoundedRectangle:
                            pos: self.pos
                            size: self.size
                            radius: [20]

                    canvas.after:
                        Color:
                            rgba: 0.6, 0.6, 0.6, 0.5
                        Line:
                            rounded_rectangle: [self.x, self.y, self.width, self.height, 20]
                            width: 1.2

                    MDLabel:
                        text: "Grafica de tendencia"
                        bold: True
                        halign: "center"
                        theme_text_color: "Secondary"
                        size_hint_y: None
                        height: self.texture_size[1]

                    GraficaTendencia:
                        id: grafica_tendencia
                        size_hint_y: None
                        height: "190dp"

                    MDLabel:
                        id: mensaje_historial
                        text: "Aun no hay datos historicos para graficar"
                        halign: "center"
                        theme_text_color: "Secondary"
                        font_size: "12sp"
                        size_hint_y: None
                        height: self.texture_size[1]
